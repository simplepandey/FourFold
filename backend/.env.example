# ===========================
# Application
# ===========================
NODE_ENV=development
PORT=3000

# ===========================
# Database
# ===========================
DATABASE_URL=postgresql://postgres:password@localhost:5432/fourfold_db

# ===========================
# JWT
# ===========================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ===========================
# OTP Configuration
# ===========================
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# ===========================
# SMS Provider
# Set SMS_PROVIDER to: console | twilio | msg91 | aws-sns
# ===========================
SMS_PROVIDER=console

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- MSG91 ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# --- AWS SNS ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===========================
# MQTT Broker
# ===========================
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TELEMETRY_TOPIC=societies/+/motors/+/telemetry
