generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  phoneNumber String   @unique
  name        String?
  password    String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phoneNumber])
  @@map("users")
}

model Otp {
  id          String   @id @default(uuid())
  phoneNumber String
  otpCode     String
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([phoneNumber])
  @@index([phoneNumber, isUsed])
  @@map("otps")
}

model Society {
  id           String   @id @default(uuid())
  societyCode  String?  @unique
  phoneNumber  String   @unique
  name         String
  societyName  String
  blockOrWing  String
  totalMembers Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([phoneNumber])
  @@index([societyCode])
  @@map("societies")
}

// Per-device access + role — the only way members get added (there's no
// society-wide roster). One person can have access to multiple devices
// within the same society, each with its own role — e.g. admin on the pump
// they registered, plain member on one a neighbor added them to. Also
// determines a user's society context on login (see auth's
// _resolveSociety), since that used to come from society_members.
model DeviceMember {
  id          String   @id @default(uuid())
  productCode String
  societyCode String
  phoneNumber String
  userId      String?
  role        String   @default("member")
  joinedAt    DateTime @default(now())

  @@unique([productCode, phoneNumber])
  @@index([productCode])
  @@index([societyCode])
  @@index([userId])
  @@index([phoneNumber])
  @@map("device_members")
}

model ModuleMaster {
  id           String    @id @default(uuid())
  serialNumber String    @unique
  createdBy    String
  createDate   DateTime  @default(now())
  updatedBy    String?
  updateDate   DateTime  @updatedAt
  isDeleted    Boolean   @default(false)

  @@index([serialNumber])
  @@index([isDeleted])
  @@map("module_master")
}

model ModuleRegistration {
  id           String    @id @default(uuid())
  productCode  String
  name         String
  registeredTo String
  noOfPump     Int
  phase        String
  hpOfPump     Float
  address      String
  wingBlock    String
  pincode      String
  district     String
  state        String    @default("Maharashtra")
  country      String    @default("India")
  createdBy    String
  createDate   DateTime  @default(now())
  updatedBy    String?
  updateDate   DateTime  @updatedAt
  isDeleted    Boolean   @default(false)

  @@index([productCode])
  @@index([isDeleted])
  @@map("module_registration")
}

model MotorCommand {
  id          String   @id @default(uuid())
  societyCode String
  motorId     String
  command     String
  commandBy   String
  cmdId       String   @default(uuid())
  status      String   @default("sent")
  createDate  DateTime @default(now())

  @@index([societyCode])
  @@index([motorId])
  @@map("motor_commands")
}

model EspRegistration {
  id           String   @id @default(uuid())
  serialNumber String
  serialHash   String
  productCode  String   @unique
  type         String?
  username     String?
  userId       String?
  societyId    String?
  topicsId     String   @unique
  createdAt    DateTime @default(now())

  topics Topic @relation(fields: [topicsId], references: [id])

  @@index([serialNumber])
  @@index([serialHash])
  @@map("esp_registrations")
}

model Topic {
  id             String   @id @default(uuid())
  commandTopic   String
  telemetryTopic String
  alertTopic     String
  heartbeatTopic String
  createdAt      DateTime @default(now())

  esp EspRegistration?

  @@map("topics")
}

model MotorTelemetry {
  id           String   @id @default(uuid())
  serialHash   String
  serialNumber String
  voltage      Float
  current      Float
  overcurrent  Float
  undercurrent Float
  groundTank   Float?
  overheadTank Float?
  motorRunning Boolean
  recordedAt   DateTime @default(now())

  @@index([serialHash])
  @@map("motor_telemetry")
}

model MotorAlert {
  id                   String   @id @default(uuid())
  serialHash           String
  serialNumber         String
  overcurrentBreached  Float?
  undercurrentBreached Float?
  recordedAt           DateTime @default(now())

  @@index([serialHash])
  @@map("motor_alerts")
}

model ModuleStatus {
  id                   String   @id @default(uuid())
  productCode          String   @unique
  voltage              Float    @default(0)
  current              Float    @default(0)
  overcurrent          Float    @default(0)
  undercurrent         Float    @default(0)
  overheadTankLevel    Int      @default(0)
  undergroundTankLevel Int      @default(0)
  motorStatus          String   @default("OFF")
  ocBreached           Boolean  @default(false)
  ucBreached           Boolean  @default(false)
  isOnline             Boolean  @default(false)
  updatedAt            DateTime @updatedAt
  updatedBy            String?

  @@index([productCode])
  @@map("module_status")
}

model TopicPatternToSubscribe {
  id        String   @id @default(uuid())
  pattern   String   @unique
  createdAt DateTime @default(now())

  @@map("topic_pattern_to_subscribe")
}

model ModuleActionLog {
  id                   String   @id @default(uuid())
  productCode          String
  voltage              Float    @default(0)
  current              Float    @default(0)
  overcurrent          Float    @default(0)
  undercurrent         Float    @default(0)
  overheadTankLevel    Int      @default(0)
  undergroundTankLevel Int      @default(0)
  motorStatus          String
  ocBreached           Boolean  @default(false)
  ucBreached           Boolean  @default(false)
  createdAt            DateTime @default(now())
  createdBy            String?

  @@index([productCode])
  @@map("module_action_logs")
}
